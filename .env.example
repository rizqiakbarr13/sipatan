# =========================================================
# Database
# =========================================================
# Dev lokal (docker compose up -d db):
DATABASE_URL="postgresql://pertanahan:pertanahan@localhost:5432/pertanahan?schema=public"
# Vercel (Neon/Supabase) atau VPS: ganti dengan connection string masing-masing.

# =========================================================
# Auth.js (NextAuth v5)
# =========================================================
# Generate dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# URL publik aplikasi (wajib diisi benar di production)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =========================================================
# Sesi akun warga (login masyarakat, terpisah dari Auth.js admin)
# =========================================================
# Opsional — jika kosong, akan memakai AUTH_SECRET sebagai fallback.
WARGA_SESSION_SECRET="ganti-dengan-string-acak-lain-minimal-32-karakter"

# =========================================================
# Akun admin default (dipakai oleh prisma/seed.ts)
# =========================================================
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL="admin@dinas-pertanahan.local"
SEED_ADMIN_PASSWORD="GantiPassword123!"

# =========================================================
# Storage dokumen & lampiran
# =========================================================
# local  -> simpan ke folder di disk (cocok untuk VPS/self-host, TIDAK untuk Vercel)
# blob   -> Vercel Blob (wajib dipakai jika deploy ke Vercel)
# s3     -> S3-compatible (AWS S3, Cloudflare R2, MinIO, dll)
STORAGE_DRIVER="local"

# Dipakai jika STORAGE_DRIVER=local. Folder di luar /public, disajikan lewat route handler.
STORAGE_LOCAL_DIR="./uploads"

# Dipakai jika STORAGE_DRIVER=blob (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Dipakai jika STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Jika bucket tidak public, set base URL CDN/publik untuk membangun link unduh
S3_PUBLIC_URL=""

# Batas ukuran upload (MB)
MAX_UPLOAD_SIZE_MB=10

# =========================================================
# Email notifikasi (opsional)
# =========================================================
RESEND_API_KEY=""
EMAIL_FROM="Pengadaan Tanah Depok <no-reply@example.com>"
